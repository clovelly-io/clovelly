{
  "name": "@clovelly/sdk",
  "version": "0.4.0",
  "description": "TypeScript client for the confidential sandbox service: places sandboxes through the control plane and talks to verified cells over gRPC.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "proto"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "protos": "node scripts/copy-protos.mjs",
    "build": "tsc -p .",
    "pretest": "tsc -p .",
    "test": "node --test dist/test/*.test.js",
    "licences": "node scripts/check-licences.mjs",
    "smoke": "node dist/examples/smoke.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
